{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Workflow Guard",
          "version": "0.2.0",
          "informationUri": "https://github.com/megern/workflow-guard",
          "rules": [
            {
              "id": "WG001"
            },
            {
              "id": "WG002"
            },
            {
              "id": "WG003"
            },
            {
              "id": "WG004"
            },
            {
              "id": "WG005"
            },
            {
              "id": "WG006"
            }
          ]
        }
      },
      "columnKind": "unicodeCodePoints",
      "results": [
        {
          "ruleId": "WG002",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "Job inherits token permissions from repository or organization defaults. Set explicit workflow permissions, or declare this job's minimal permissions."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/workflows/defaults.yml"
                },
                "region": {
                  "startLine": 4,
                  "startColumn": 3
                }
              }
            }
          ],
          "properties": {
            "evidence": "No workflow-level or job-level permissions declaration.",
            "job": "inherited"
          }
        },
        {
          "ruleId": "WG001",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "All available GITHUB_TOKEN permissions are writable. Declare only the individual permissions required by this scope."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/workflows/risky.yml"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 14
                }
              }
            }
          ],
          "properties": {
            "evidence": "permissions: write-all",
            "job": null
          }
        },
        {
          "ruleId": "WG005",
          "ruleIndex": 4,
          "level": "warning",
          "message": {
            "text": "Remote dependency reference is mutable or lacks an immutable pin. Pin the remote action or reusable workflow to a verified full commit SHA."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/workflows/risky.yml"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 15
                }
              }
            }
          ],
          "properties": {
            "evidence": "actions/checkout@main",
            "job": "build"
          }
        },
        {
          "ruleId": "WG003",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "Privileged pull_request_target workflow checks out pull-request head input. Keep untrusted pull-request code in an unprivileged workflow; review any subsequent execution."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/workflows/risky.yml"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 16
                }
              }
            }
          ],
          "properties": {
            "evidence": "checkout ref: ${{ github.event.pull_request.head.sha }}",
            "job": "build"
          }
        },
        {
          "ruleId": "WG004",
          "ruleIndex": 3,
          "level": "error",
          "message": {
            "text": "Event input is interpolated directly into script source. Pass untrusted input via env and quote the shell variable; review transformations and shell usage."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/workflows/risky.yml"
                },
                "region": {
                  "startLine": 13,
                  "startColumn": 17
                }
              }
            }
          ],
          "properties": {
            "evidence": "${{ github.event.pull_request.title }}",
            "job": "build"
          }
        },
        {
          "ruleId": "WG006",
          "ruleIndex": 5,
          "level": "error",
          "message": {
            "text": "An echo command directly references a secret expression; inspect its output destination. Avoid printing secret values. Log masking does not guarantee redaction of transformed data."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/workflows/risky.yml"
                },
                "region": {
                  "startLine": 15,
                  "startColumn": 20
                }
              }
            }
          ],
          "properties": {
            "evidence": "${{ secrets.DEMO_TOKEN }}",
            "job": "build"
          }
        }
      ],
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ]
    }
  ]
}
